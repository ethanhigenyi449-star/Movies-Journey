<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Movies Journey</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#080808;
  color:white;
}

/* HEADER */
header{
  position:sticky;
  top:0;
  z-index:1000;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:16px 5%;
  background:rgba(0,0,0,.95);
  border-bottom:1px solid #222;
}

.logo{
  font-size:25px;
  font-weight:bold;
}

.logo span{
  color:#e50914;
}

nav a{
  color:white;
  text-decoration:none;
  margin-left:20px;
}

/* HERO */
.hero{
  min-height:520px;
  padding:100px 6%;
  display:flex;
  align-items:center;
  background:
    linear-gradient(90deg,#000 15%,rgba(0,0,0,.75),rgba(0,0,0,.2)),
    radial-gradient(circle at 80% 40%,#8b1720,#170608 45%,#000);
}

.hero-content{
  max-width:650px;
}

.hero h1{
  font-size:clamp(42px,7vw,75px);
  margin:15px 0;
}

.hero p{
  color:#ccc;
  font-size:18px;
  line-height:1.6;
}

.hero-buttons{
  margin-top:25px;
}

.btn{
  display:inline-block;
  padding:12px 20px;
  border:0;
  border-radius:6px;
  background:#e50914;
  color:white;
  text-decoration:none;
  font-weight:bold;
  cursor:pointer;
  margin-right:7px;
}

.btn:hover{
  background:#b20710;
}

.dark-btn{
  background:#333;
}

/* SEARCH */
.search-area{
  background:#151515;
  padding:22px 5%;
}

#search{
  width:100%;
  padding:15px;
  border-radius:7px;
  border:1px solid #333;
  background:#222;
  color:white;
  font-size:16px;
}

/* SECTIONS */
section{
  padding:40px 5%;
}

.section-title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:22px;
}

.section-title h2{
  font-size:25px;
}

/* CATEGORIES */
.categories{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.category{
  padding:11px 17px;
  border-radius:20px;
  background:#222;
  border:1px solid #333;
  cursor:pointer;
}

.category:hover,
.category.active{
  background:#e50914;
}

/* MOVIES */
.movies{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(190px,1fr));
  gap:20px;
}

.movie{
  background:#171717;
  border-radius:8px;
  overflow:hidden;
  transition:.25s;
}

.movie:hover{
  transform:translateY(-5px);
}

.poster{
  height:280px;
  position:relative;
  display:flex;
  align-items:end;
  padding:15px;
  background-size:cover;
  background-position:center;
}

.poster:after{
  content:"";
  position:absolute;
  inset:45% 0 0;
  background:linear-gradient(transparent,#000);
}

.poster h3{
  position:relative;
  z-index:2;
}

.movie-info{
  padding:15px;
}

.genre{
  color:#ff6464;
  font-size:13px;
}

.rating{
  margin:9px 0;
  color:#ffc107;
}

.description{
  color:#aaa;
  font-size:13px;
  line-height:1.5;
  min-height:40px;
}

.movie-buttons{
  margin-top:12px;
}

/* WHATSAPP */
.whatsapp{
  position:fixed;
  right:20px;
  bottom:20px;
  z-index:999;
  width:58px;
  height:58px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#25D366;
  color:white;
  text-decoration:none;
  font-size:27px;
  box-shadow:0 4px 15px #000;
}

/* FOOTER */
footer{
  padding:35px 5%;
  text-align:center;
  background:#111;
  color:#888;
  margin-top:30px;
}

.no-results{
  display:none;
  text-align:center;
  color:#999;
  padding:40px;
}

/* MOBILE */
@media(max-width:650px){

  header{
    padding:14px 4%;
  }

  nav{
    display:none;
  }

  .hero{
    min-height:450px;
    padding:70px 5%;
  }

  .hero h1{
    font-size:42px;
  }

  .movies{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:12px;
  }

  .poster{
    height:230px;
  }

  .movie-info{
    padding:10px;
  }

  .movie-info h3{
    font-size:15px;
  }

  .btn{
    padding:9px 11px;
    font-size:12px;
  }
}
</style>
</head>

